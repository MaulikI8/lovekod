DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve root homepage immediately with index.html (never let passenger intercept root)
  RewriteRule ^$ index.html [L]
  RewriteRule ^index\.html$ - [L]

  # Social media crawler detection for rich product preview unfurling (WhatsApp, Facebook, Twitter, Telegram, etc.)
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Pinterest|Googlebot) [NC]
  RewriteRule ^product/([^/]+)/?$ /api/preview/product/$1/ [PT,L]

  # Direct preview shortlink routing to Django OG preview
  RewriteRule ^p/([^/]+)/?$ /api/preview/product/$1/ [PT,L]

  # Exclude Backend API, Django Admin, Static, and Media from React SPA fallback
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^/django-admin [NC,OR]
  RewriteCond %{REQUEST_URI} ^/static [NC,OR]
  RewriteCond %{REQUEST_URI} ^/media [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Never cache HTML or Service Worker files so visitors always get the latest bundle immediately
<FilesMatch "\.(html|htm|webmanifest)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Caching for immutable hashed assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
